# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# OpenAI
OPENAI_API_KEY=

# Voice notes. Neither the app nor Hermes reads a transcription model from
# this file — the running setting is stt.openai.model in ~/.hermes/config.yaml,
# and it is whisper-1. Hermes' own env override is STT_OPENAI_MODEL, and it
# accepts only whisper-1, gpt-4o-mini-transcribe or gpt-4o-transcribe. The
# OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe that used to sit here named a model
# that does not exist and a variable nothing reads, so it looked configured
# while whisper-1 quietly did the work.

# Hermes runs beside the app and pairs to WhatsApp by QR code.
# Fill these with the address and session name used by your Hermes process.
NEXT_PUBLIC_TED_WHATSAPP_NUMBER=
HERMES_BASE_URL=http://127.0.0.1:3000
HERMES_SESSION_NAME=ted
TED_HERMES_ADAPTER_URL=http://127.0.0.1:3001/api/hermes/messages

# Ted's per-user memory. The gateway reads ~/.hermes/.env, NOT this file, so
# both of these must be set THERE as well or ted_memory_save is never
# registered and Ted forgets every user after the next restart.
# TED_CONVEX_SITE_URL is the Convex HTTP actions URL (the .convex.site one).
# TED_HERMES_SHARED_SECRET must match the secret the /ted-memory route checks.
TED_CONVEX_SITE_URL=
TED_HERMES_SHARED_SECRET=

# Optional override for `npm run submission:report`. Left empty, the script
# reads the deployment from TED_CONVEX_SITE_URL in ~/.hermes/.env (the live
# gateway's backend). Set this only to point the report at a different one.
TED_CONVEX_DEPLOYMENT=

# Vercel creates this automatically for connected deployments.
# It is not required for ordinary local development.
VERCEL_OIDC_TOKEN=

# ── The website's own numbers (/metrics) ──────────────────────────────────
# Unique visitors, taps on "Message Ted", and first conversations, on one page.
#
# TED_SITE_SECRET is the one thing the Next.js server and Convex must agree on:
# it guards both writing a visit and reading the dashboard. Set the SAME value
# in both places, or the page collects nothing and says so:
#   npx convex env set TED_SITE_SECRET "$(openssl rand -hex 24)"
#   vercel env add TED_SITE_SECRET
TED_SITE_SECRET=

# Salts the visitor hash so nobody can confirm a guessed address visited.
# Optional — without it the code falls back to a published constant, which
# still counts correctly but is guessable. Any random string will do.
SITE_EVENT_SALT=

# The password in the dashboard link: /metrics?key=... . No key set means the
# page 404s for everyone, which is the safe default; a live page of numbers
# with no key is worse than no page.
METRICS_KEY=
