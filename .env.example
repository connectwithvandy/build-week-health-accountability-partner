# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Hermes runs beside the app and pairs to WhatsApp by QR code.
# Fill these with the address and session name used by your Hermes process.
NEXT_PUBLIC_TED_WHATSAPP_NUMBER=
HERMES_BASE_URL=http://127.0.0.1:3000
HERMES_SESSION_NAME=ted
TED_HERMES_ADAPTER_URL=http://127.0.0.1:3001/api/hermes/messages

# Ted's per-user memory. The gateway reads ~/.hermes/.env, NOT this file, so
# both of these must be set THERE as well or ted_memory_save is never
# registered and Ted forgets every user after the next restart.
# TED_CONVEX_SITE_URL is the Convex HTTP actions URL (the .convex.site one).
# TED_HERMES_SHARED_SECRET must match the secret the /ted-memory route checks.
TED_CONVEX_SITE_URL=
TED_HERMES_SHARED_SECRET=

# Vercel creates this automatically for connected deployments.
# It is not required for ordinary local development.
VERCEL_OIDC_TOKEN=
