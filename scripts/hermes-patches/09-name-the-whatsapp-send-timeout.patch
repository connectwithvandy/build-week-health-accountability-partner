+        except asyncio.TimeoutError:
+            # Ted patch 09. str(asyncio.TimeoutError()) is the empty string, so
+            # the bare `except Exception` below returned error="" and the log
+            # line read "Send failed: " with nothing after it. Both guards in
+            # BasePlatformAdapter._send_with_retry key off the words "timed
+            # out", and neither can fire against an empty string, so a timeout
+            # was read as a formatting failure and re-sent as plain text.
+            #
+            # A timeout here says nothing about delivery. The bridge keeps the
+            # message and WhatsApp usually accepts it: on 5 Sep 2026 at 21:03
+            # a beta user received the same reply three times off one send,
+            # because this exception arrived nameless. Name it, so the
+            # may-already-be-delivered guard upstream can do its job.
+            return SendResult(
+                success=False,
+                error=(
+                    f"Send timed out after 30s waiting for the WhatsApp bridge "
+                    f"(chat {chat_id}); the message may already have been delivered"
+                ),
+                retryable=False,
+            )
         except Exception as e:
-            return SendResult(success=False, error=str(e))
+            # An exception whose str() is empty is the same trap as the timeout
+            # above. Never hand the retry logic a blank error to reason about.
+            return SendResult(
+                success=False,
+                error=str(e) or f"{type(e).__name__} (no detail)",
+            )
 
