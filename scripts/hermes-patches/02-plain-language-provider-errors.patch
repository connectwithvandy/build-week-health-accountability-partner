+# Operational status that names the model/provider or narrates the retry
+# machinery. SOUL-style personas ("never expose model names, provider names,
+# gateway events") need these gone from chat, and they carry no action a chat
+# user can take. Detail still reaches agent.log via the logger.warning at each
+# emission site — only the chat copy is affected.
+_GATEWAY_PROVIDER_STALL_RE = re.compile(
+    r"("
+    r"no\s+response\s+from\s+provider\s+for\s+\d+"
+    r"|no\s+output\s+from\s+provider\s+for\s+\d+"
+    r"|codex\s+stream\s+sent\s+no\s+events\s+for\s+\d+"
+    r"|no\s+events\s+from\s+bedrock\s+for\s+\d+"
+    r")",
+    re.IGNORECASE,
+)
+
+# User-facing copy for each provider-failure category, overridable per install
+# via ``display.provider_messages.<key>`` in config.yaml so a persona-driven
+# gateway can speak in its own voice without patching this file. Defaults
+# reproduce the historical wording exactly. A key set to an empty string
+# suppresses that category from chat entirely (it still reaches the logs).
+_GATEWAY_PROVIDER_MESSAGE_DEFAULTS = {
+    "auth": (
+        "⚠️ Provider authentication failed. Check the configured credentials; "
+        "raw provider details are in the gateway logs."
+    ),
+    "policy": (
+        "⚠️ The model provider rejected the request. I kept the raw provider "
+        "error out of chat; check gateway logs for details or try rephrasing."
+    ),
+    "rate_limit": (
+        "⏱️ The model provider is rate-limiting requests. Please wait a moment "
+        "and try again."
+    ),
+    "generic": (
         "⚠️ The model provider failed after retries. I kept raw provider details "
         "out of chat; check gateway logs for diagnostics."
-    )
+    ),
+    # Mid-call stall chatter. Defaults to suppression: it names the model and
+    # context size, repeats once per reconnect, and the user has nothing to do
+    # with it. On terminal failure the "generic" line above is still delivered,
+    # so a failed turn is never silent.
+    "stall": "",
+}
+
+
+def _gateway_provider_message(key: str) -> str:
+    """Resolve user-facing provider-failure copy, honouring config overrides."""
+    default = _GATEWAY_PROVIDER_MESSAGE_DEFAULTS.get(key, "")
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        override = cfg_get(
+            load_config_readonly(), "display", "provider_messages", key
+        )
+    except Exception:
+        return default
+    if override is None:
+        return default
+    return str(override).strip()
+
+
+def _gateway_provider_error_reply(text: str) -> str:
+    """Map raw provider/API errors to a short user-safe chat reply."""
+    if _GATEWAY_AUTH_ERROR_RE.search(text):
+        return _gateway_provider_message("auth")
+    if _GATEWAY_PROVIDER_POLICY_RE.search(text):
+        return _gateway_provider_message("policy")
+    if _GATEWAY_RATE_LIMIT_RE.search(text):
+        return _gateway_provider_message("rate_limit")
+    return _gateway_provider_message("generic")
 
 
