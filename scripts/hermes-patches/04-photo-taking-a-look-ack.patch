+# How long one photo burst lasts. WhatsApp delivers several photos of the same
+# plate as separate messages, each its own event, so an acknowledgement that is
+# only per-event still produces five of them. PRODUCT_BUILD_GUARDRAILS: "one
+# user action should feel like one interaction".
+_GATEWAY_PHOTO_ACK_WINDOW_SECONDS = 90.0
+
+# User-facing copy for slow-media acknowledgements, overridable per install via
+# ``display.media_ack.<key>`` in config.yaml. An empty string turns it off.
+_GATEWAY_MEDIA_ACK_DEFAULTS = {
+    "image": "ooh a pic \U0001f440 taking a look, one sec\u2026",
+}
+
+
+def _gateway_media_ack_message(key: str) -> str:
+    """Resolve slow-media acknowledgement copy, honouring config overrides."""
+    default = _GATEWAY_MEDIA_ACK_DEFAULTS.get(key, "")
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        override = cfg_get(load_config_readonly(), "display", "media_ack", key)
+    except Exception:
+        return default
+    if override is None:
+        return default
+    return str(override).strip()
 
 
