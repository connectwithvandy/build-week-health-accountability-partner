diff --git a/gateway/run.py b/gateway/run.py
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -517,6 +517,32 @@
     if len(body) > 400 or body.count("\n") > 4:
         return False
     return bool(_GATEWAY_PROVIDER_ERROR_SHAPE_RE.search(body))
+
+
+# Ted patch 11. Every sentinel `agent/conversation_loop.py` returns as a turn's
+# `final_response` when it gives up. All of them have been deliverable to a
+# WhatsApp user verbatim, and two are worse than the one that was: the
+# thinking-budget block tells a person in a health chat to run `/thinkon low`
+# or `/model`, and the no-fallback line tells them to edit config.yaml.
+#
+# One pattern rather than one per failure shape, because they all resolve to
+# the same reply. Neither of the last two is caught by
+# `_looks_like_gateway_provider_error`, which was checked rather than assumed,
+# so dropping them here would send the raw text.
+#
+# The raw sentinel still reaches agent.log at every emission site. Only the
+# chat copy changes.
+_GATEWAY_INTERNAL_FAILURE_RE = re.compile(
+    r"(?:first\s+)?response\s+truncated\s+due\s+to\s+output\s+length"
+    r"|response\s+remained\s+truncated\s+after\s+\d+\s+continuation"
+    r"|thinking\s+budget\s+exhausted"
+    r"|stream\s+repeatedly\s+dropped\s+mid\s+tool-?call"
+    r"|incomplete\s+REASONING_SCRATCHPAD"
+    r"|response\s+remained\s+incomplete\s+after\s+\d+\s+continuation"
+    r"|invalid\s+API\s+response\s+after\s+\d+\s+retries"
+    r"|no\s+fallback\s+provider\s+available",
+    re.IGNORECASE,
+)
 
 
 def _sanitize_gateway_final_response(platform: Any, text: str) -> str:
